# SkillSpector "Static + LLM" through OpenAI. Usage is billed to your OpenAI account.
# Copy to .scanners/skillspector-openai.env and put your key after OPENAI_API_KEY=
# (install.sh can do this for you). The .scanners/ folder is never committed.
SKILLSPECTOR_PROVIDER=openai
OPENAI_API_KEY=
SKILLSPECTOR_MODEL=gpt-5.4
# Paid plans can take several requests at once. SkillsGoat defaults to 1 (for free plans).
SKILLSPECTOR_MAX_LLM_CONCURRENCY=4

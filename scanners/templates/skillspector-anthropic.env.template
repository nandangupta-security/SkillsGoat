# SkillSpector "Static + LLM" through Anthropic (Claude). Usage is billed to your Anthropic account.
# Copy to .scanners/skillspector-anthropic.env and put your key after ANTHROPIC_API_KEY=
# (install.sh can do this for you). The .scanners/ folder is never committed.
SKILLSPECTOR_PROVIDER=anthropic
ANTHROPIC_API_KEY=
SKILLSPECTOR_MODEL=claude-sonnet-5-5
# Paid plans can take several requests at once. SkillsGoat defaults to 1 (for free plans).
SKILLSPECTOR_MAX_LLM_CONCURRENCY=4

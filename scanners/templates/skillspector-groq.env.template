# SkillSpector "Static + LLM" through Groq's OpenAI-compatible endpoint.
# Copy to .scanners/skillspector-groq.env and put your key after COMPAT_API_KEY=
# (install.sh can do this for you). The .scanners/ folder is never committed.
SKILLSPECTOR_PROVIDER=openai_compatible
SKILLSPECTOR_COMPAT_BASE_URL=https://api.groq.com/openai/v1
SKILLSPECTOR_COMPAT_API_KEY=
SKILLSPECTOR_MODEL=openai/gpt-oss-120b
SKILLSPECTOR_REASONING_EFFORT=low
